    <!-- 백그라운드 위치 명시적 안내 (Play 정책) -->
    <string name="disclosure_title">Before you start sharing</string>
    <string name="disclosure_body">PinLink collects your location — including when the app is closed or running in the background — to show it to the members of the room you joined. Sharing stops when the time you chose ends, when you tap \"Hide my location\", or when you leave the room. Your coordinates are sent to the room\'s server and remain only while the room is active.</string>
    <string name="disclosure_accept">I understand — continue</string>
    <string name="disclosure_decline">Not now</string>
    <string name="bg_disclosure_title">Allow location all the time?</string>
    <string name="bg_disclosure_body">To keep sharing after you close PinLink, choose \"Allow all the time\" for location. If you choose \"While using the app\", sharing stops when you leave the app.</string>
    <string name="bg_disclosure_open">Open settings</string>
    <string name="bg_disclosure_later">Later</string>

