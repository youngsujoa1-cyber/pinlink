rules_version = '2'; service cloud.firestore { match /databases/{database}/documents { function okCode(c) { return c is string && c.matches('^[A-Z0-9]{6}$'); } match /rooms/{code} { allow read: if true; allow create, update: if okCode(code) && request.resource.data.size() <= 14 && request.resource.data.code == code && (!request.resource.data.keys().hasAny(['owner']) || (request.resource.data.owner is string && request.resource.data.owner.size() <= 40)) && (!request.resource.data.keys().hasAny(['meetingName']) || (request.resource.data.meetingName is string && request.resource.data.meetingName.size() <= 60)) && (!request.resource.data.keys().hasAny(['meetingBy']) || (request.resource.data.meetingBy is string && request.resource.data.meetingBy.size() <= 40)); allow delete: if false; match /members/{deviceId} { allow read: if true; allow create, update: if okCode(code) && request.resource.data.size() <= 8 && request.resource.data.lat is number && request.resource.data.lat >= -90 && request.resource.data.lat <= 90 && request.resource.data.lng is number && request.resource.data.lng >= -180 && request.resource.data.lng <= 180 && (!request.resource.data.keys().hasAny(['name']) || (request.resource.data.name is string && request.resource.data.name.size() <= 40)); allow delete: if true; } match /messages/{msgId} { allow read: if true; allow create: if okCode(code) && request.resource.data.size() <= 5 && request.resource.data.senderId is string && request.resource.data.senderId.size() > 0 && request.resource.data.senderId.size() <= 64 && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 500 && request.resource.data.createdAtMs is int && request.resource.data.createdAtMs > 0 && (!request.resource.data.keys().hasAny(['senderName']) || (request.resource.data.senderName is string && request.resource.data.senderName.size() <= 40)) && (!request.resource.data.keys().hasAny(['senderColor']) || (request.resource.data.senderColor is string && request.resource.data.senderColor.size() <= 9)); allow update: if false; allow delete: if false; } } match /{document=**} { allow read, write: if false; } } }
